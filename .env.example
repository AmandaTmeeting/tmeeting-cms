HOST=0.0.0.0
PORT=1337

# Secrets — generate fresh values for each environment
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database — SQLite for local dev, Postgres for production (Phase 2d)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# i18n — sets the initial default locale on first boot
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=sv
